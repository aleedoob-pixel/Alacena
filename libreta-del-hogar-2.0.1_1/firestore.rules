rules_version = '2';

// Reglas de seguridad de la Libreta del hogar.
//
// Cada persona entra con su cuenta de Google. Los datos de un hogar solo los puede leer y escribir quien
// figure entre sus integrantes. Para sumarse a un hogar hace falta una invitación: un código de 8 letras
// que crea alguien que ya es integrante, que vale 15 minutos y que se gasta (se borra) en la misma
// operación en que se usa.
//
// Aparte están los precios que los hogares eligen compartir con su zona: no dicen quién los cargó, los
// puede leer cualquiera que haya entrado con su cuenta y solo se aceptan si tienen la forma esperada.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    // ¿Esta persona ya figura entre los integrantes del hogar?
    function esMiembro(hogar) {
      return conSesion()
        && exists(/databases/$(database)/documents/hogares/$(hogar)/miembros/$(request.auth.uid));
    }

    function invitacion(codigo) {
      return get(/databases/$(database)/documents/invitaciones/$(codigo)).data;
    }

    function invitacionVale(codigo, hogar) {
      return invitacion(codigo).hogar == hogar
        && request.time < invitacion(codigo).creada + duration.value(15, 'm');
    }

    // Lo que cada cuenta anota de sí misma: su nombre y en qué hogar está (para volver a él desde otro teléfono).
    match /usuarios/{uid} {
      allow get, create, update, delete: if conSesion() && uid == request.auth.uid;
    }

    match /hogares/{hogar} {
      allow get: if esMiembro(hogar);
      allow create: if conSesion() && request.resource.data.creador == request.auth.uid;
      allow update: if esMiembro(hogar) && request.resource.data.creador == resource.data.creador;
      allow delete: if esMiembro(hogar);

      // Un documento por integrante del hogar.
      match /miembros/{uid} {
        // Cada persona puede mirar su propio lugar (así sabe si la quitaron); la lista, solo los integrantes.
        allow get: if esMiembro(hogar) || (conSesion() && uid == request.auth.uid);
        allow list: if esMiembro(hogar);
        // Se anota quien crea el hogar, en la misma operación en que lo crea; o, si el hogar ya existe,
        // quien trae una invitación vigente para ese hogar y la borra en la misma operación.
        allow create: if conSesion()
          && uid == request.auth.uid
          && (
            (!exists(/databases/$(database)/documents/hogares/$(hogar))
              && getAfter(/databases/$(database)/documents/hogares/$(hogar)).data.creador == request.auth.uid)
            || (exists(/databases/$(database)/documents/hogares/$(hogar))
              && request.resource.data.codigo is string
              && invitacionVale(request.resource.data.codigo, hogar)
              && !existsAfter(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigo)))
          );
        allow update: if esMiembro(hogar) && uid == request.auth.uid;
        allow delete: if esMiembro(hogar);
      }

      match /productos/{producto} {
        allow read, write: if esMiembro(hogar);
      }

      // Los tickets, juntos por mes.
      match /meses/{mes} {
        allow read, write: if esMiembro(hogar);
      }

      // Las notas que se dejan entre integrantes.
      match /notas/{nota} {
        allow read, write: if esMiembro(hogar);
      }
    }

    // Invitaciones para sumar a alguien. Solo se pueden leer de a una y sabiendo el código.
    match /invitaciones/{codigo} {
      allow get: if conSesion();
      allow create: if conSesion()
        && codigo.size() == 8
        && request.resource.data.keys().hasOnly(['hogar', 'por', 'creada'])
        && request.resource.data.por == request.auth.uid
        && request.resource.data.creada == request.time
        && esMiembro(request.resource.data.hogar);
      // La borra quien la creó, cualquier integrante de su hogar, o quien entra con ella en esta misma operación.
      allow delete: if conSesion()
        && (resource.data.por == request.auth.uid
          || esMiembro(resource.data.hogar)
          || existsAfter(/databases/$(database)/documents/hogares/$(resource.data.hogar)/miembros/$(request.auth.uid)));
    }

    // Precios compartidos entre hogares: el precio de un producto (por su código de barras) en un comercio
    // (por su identificador de Google Maps), en una zona. No llevan nombre, hogar ni cuenta de quien los cargó.
    //   z zona · e código de barras · ze = z_e · k comercio · p precio · d día de la compra · c cuántos lo
    //   confirmaron · la, lo dónde queda el comercio · v día hasta el que vale (30 días como mucho) ·
    //   x el momento desde el que se puede borrar solo (dos días después de v)
    // Los días van como «días desde 1970»; se comparan con la hora del servidor con margen, porque el día
    // lo cuenta cada teléfono según su huso horario.
    // Para que los vencidos se borren solos aunque nadie pase por esa zona, en la consola de Google Cloud se
    // puede crear una regla de «tiempo de vida» (TTL) para la colección `precios` con el campo `x`.
    match /precios/{id} {
      allow read: if conSesion();
      allow create, update: if conSesion()
        && request.resource.data.keys().hasOnly(['z', 'e', 'ze', 'k', 'p', 'd', 'c', 'la', 'lo', 'v', 'x'])
        && request.resource.data.keys().hasAll(['z', 'e', 'ze', 'k', 'p', 'd', 'c', 'la', 'lo', 'v', 'x'])
        && request.resource.data.z is string && request.resource.data.z.matches('^[0-9]{1,4}x[0-9]{1,4}$')
        && request.resource.data.e is string && request.resource.data.e.matches('^[0-9]{8,14}$')
        && request.resource.data.k is string && request.resource.data.k.size() >= 5 && request.resource.data.k.size() <= 300
        && request.resource.data.ze == request.resource.data.z + '_' + request.resource.data.e
        && id == request.resource.data.ze + '_' + request.resource.data.k
        && request.resource.data.p is number && request.resource.data.p > 0 && request.resource.data.p < 1000000000
        && request.resource.data.d is int
        && request.resource.data.d * 86400000 >= request.time.toMillis() - 5 * 86400000
        && request.resource.data.d * 86400000 <= request.time.toMillis() + 86400000
        && request.resource.data.v is int
        && request.resource.data.v >= request.resource.data.d
        && request.resource.data.v <= request.resource.data.d + 30
        && request.resource.data.x is timestamp
        && request.resource.data.x.toMillis() == (request.resource.data.v + 2) * 86400000
        && request.resource.data.c is int && request.resource.data.c >= 1 && request.resource.data.c <= 9999
        && request.resource.data.la is number && request.resource.data.la >= -90 && request.resource.data.la <= 90
        && request.resource.data.lo is number && request.resource.data.lo >= -180 && request.resource.data.lo <= 180;
      // Uno vencido lo puede borrar cualquiera: así no queda guardado más tiempo del debido.
      allow delete: if conSesion() && resource.data.v * 86400000 < request.time.toMillis() - 2 * 86400000;
    }
  }
}
